# Rust / Tauri
/src-tauri/target/
# gen/android 要入库：AndroidManifest、gradle 配置、res 资源都要手改，
# 不入库的话每次重新 `cargo tauri android init` 会把这些改动冲掉。
# 它自带的 .gitignore 已经排除 build/、.gradle/、jniLibs/*.so 等产物。
/src-tauri/gen/schemas/
/src-tauri/vendor/live_core/target/
# live_core 是被 src-tauri 依赖的子 crate，依赖版本由上层 Cargo.lock 锁定，
# 子 crate 自己的 lock 文件不入库。
/src-tauri/vendor/live_core/Cargo.lock
**/*.rs.bk
*.pdb
*.log

# 构建产物（dist/ 只保留随包分发的说明文件，可执行文件不入库）
/dist/*
!/dist/README.txt

# 临时文件
/.tmp/
*.bak
*.tmp
.DS_Store
Thumbs.db
__pycache__/
*.pyc
.venv/
node_modules/
# 没取到 LOCALAPPDATA 时会落到当前目录（只在极简环境下出现，不该进仓库）
gpu-sandbox-broken.flag

# 个人工作笔记（不入库）
ToDo.md
需求.md

# 本机排查 WebView2 显示问题时写的诊断脚本（只在本机用，不入库）
/tools/crash_probe.py
/tools/diag_dwm.py
/tools/gpu_matrix2.py
/tools/inspect_win.py
/tools/job_check.py
/tools/minimize_others.py
/tools/pixel_stat.py
/tools/shot_any.py
/tools/type_text.py

# 排查「看一段时间卡一下」时写的直链探针与等价代理（只在本机用）
/tools/flv_probe.py
/tools/flv_proxy.py

# 接入抖音/快手时写的取流探针、弹幕握手探针与一键复现脚本（只在本机用）
/tools/douyin_flv_probe.py
/tools/ws_probe_douyin.py
/tools/dy_repro.py
# 抖音签名/快手翻页的一次性验证脚本（直接抓页面 bundle 改着跑，不进仓库）
/tools/probe/

# 图片：只保留文档配图与运行/构建必需的资源，其余一律忽略
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
!docs/img/
!docs/img/**
!web/assets/**
!src-tauri/icons/**

# 平台协议速查（含签名细节，只留本地，不入库）
docs/platform-protocols.md
docs/reference-spec.md
docs/hidden-features.md
