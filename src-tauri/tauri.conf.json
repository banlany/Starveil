{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "星幕直播",
  "version": "0.3.7",
  "identifier": "top.june6699.starveil",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "星幕直播",
        "width": 1280,
        "height": 800,
        "minWidth": 1080,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
