<?xml version="1.0" encoding="utf-8"?>
<!--
  release 包默认禁止明文 HTTP（manifest 里 usesCleartextTraffic 的 release 占位符是 false），
  而 FLV 直播走的是本机 127.0.0.1 上的流代理，禁掉就拉不出画面。
  这里只对回环地址开口子，外部域名仍然只允许 HTTPS。
  该文件优先于 android:usesCleartextTraffic，debug 包的行为不受影响。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
